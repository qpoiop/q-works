{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "team-task-app",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "rules": [{ "type": "Text", "globs": ["**/*.sql"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "team-task-db",
      "database_id": "b7d3c6ab-ae33-478a-8ff3-d6452fc74d7f",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "AVATARS", "bucket_name": "q-works-avatars" }],
  // 과금 방어: IP당 분당 요청 제한 (읽기 120/분, 쓰기 30/분)
  "ratelimits": [
    { "name": "RL_READ", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_WRITE", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_AUTH", "namespace_id": "1003", "simple": { "limit": 8, "period": 60 } }
  ],
  // Web Push(VAPID) — 공개키·subject는 공개값(vars). 비밀키는 시크릿:
  //   npx wrangler secret put VAPID_PRIVATE
  "vars": {
    "VAPID_PUBLIC": "BPC5SRAodVabIqXBlqYNOw3iWeyJ8V1Prt4zGXuqISQGBBPcvbOD6ZFaU4NZvaAcIdfmCooD-3ugt8zn10rIikk",
    "VAPID_SUBJECT": "mailto:qpoiop3@gmail.com"
  }
}
